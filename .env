# Copy this file to .env.local and fill in real values before running.

# Postgres connection string.
# If you use the included docker-compose.yml as-is, this default matches it.
DATABASE_DB=propertyads
DATABASE_HOST=localhost
DATABASE_POST=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=root

# Secret used to sign admin login JWTs. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_secret

# Admin login credentials.
# Run `npm run seed-admin` after setting these to create the admin record.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
